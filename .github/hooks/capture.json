{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture.ps1 -Event userPromptSubmitted",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture.ps1 -Event agentStop",
        "timeoutSec": 10
      }
    ]
  }
}
